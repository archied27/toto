{
    "compilerOptions": {
      "paths": {
        "@/*": ["./src/*"]
      },
      "skipLibCheck": true,
      "ignoreDeprecations": "6.0",

      /* Bundler mode */
      "moduleResolution": "bundler",
      "verbatimModuleSyntax": true,
      "moduleDetection": "force",
      "composite": true,
      "outDir": "./dist",              // Add this - where compiled JS goes
      "declarationDir": "./dist/types", // Add this - where .d.ts goes
      "declaration": true,              // Add this - enable declarations
      "rootDir": "./src",               // Add this - preserve src structure
      "jsx": "react-jsx",

      /* Linting */
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "erasableSyntaxOnly": true,
      "noFallthroughCasesInSwitch": true
    },
    "include": ["src"]
}